# ═══════════════════════════════════════════════════════════════════════════
#  AgentOS — environment configuration template
#  Copy to `.env` and fill in real values. NEVER commit `.env`.
#
#  Per-user API keys, mode (paid/free/local) and token budgets are stored in
#  the database and managed from the in-app Settings panel. The values below
#  are used for server-wide defaults and for unauthenticated/local-dev runs.
# ═══════════════════════════════════════════════════════════════════════════

# ── Server & security ───────────────────────────────────────────────────────
PORT=8080
# REQUIRED in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_URL=sqlite+aiosqlite:///./agentos.db

# ── Local-dev defaults for the API mode (used when no user is logged in) ───
#  USE_PAID_API=true  → paid cloud providers
#  USE_FREE_VERSIONS=true → free g4f web models (falls back to local Codex)
#  both false → local Codex only
USE_PAID_API=false
USE_FREE_VERSIONS=true

# ── Cloud providers (server-wide fallback keys) ─────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Preferred provider tried first in the paid fallback chain: openai | anthropic | gemini
SENIOR_MODEL_PROVIDER=gemini

# Senior-tier models (Supervisor / Codex / Research)
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-3-7-sonnet-latest
GEMINI_MODEL=gemini-2.5-pro

# Fast-tier models (routing, memory compression, DB agent)
OPENAI_FAST_MODEL=gpt-4o-mini
ANTHROPIC_FAST_MODEL=claude-3-5-haiku-20241022
GEMINI_FAST_MODEL=gemini-2.5-flash

# ── Local Codex engine (codex_engine/, llama-cpp-python) ────────────────────
# Master switch: false removes the local model from every fallback chain.
LOCAL_CODEX=true
# true → auto-start the embedded engine on :8090 when it is needed.
LOCAL_CODEX_EMBEDDED=true
LOCAL_CODEX_URL=http://localhost:8090/v1
LOCAL_CODEX_MODEL=qwen2.5-coder-7b-instruct
LOCAL_CODEX_MODEL_PATH=
# Force a model tier: 7b | 7b-light | 14b | 32b (empty = auto-detect)
LOCAL_CODEX_FORCE_SIZE=
# Allow mmap paging of model weights to SSD when RAM is tight.
LOCAL_CODEX_SSD_OVERFLOW=true
BYPASS_RAM_CHECK=false
# Unload the model after N idle seconds (0 = never).
LOCAL_CODEX_IDLE_UNLOAD_SECONDS=0

# ── Memory ──────────────────────────────────────────────────────────────────
MEMORY_TOKEN_BUDGET=512

# ── Tier-0 Edge Reflex Router (edge_router.py) ──────────────────────────────
# Backend: none | rules | embedding | onnx | microllm
EDGE_ROUTER_BACKEND=rules
EDGE_ROUTER_MIN_MARGIN=0.25
EDGE_ROUTER_MAX_SPAN_ENTROPY=0.6
# Backend-specific (only needed for the matching backend)
EDGE_ROUTER_ONNX_MODEL_PATH=
EDGE_ROUTER_EMBED_MODEL=BAAI/bge-small-en-v1.5
EDGE_ROUTER_MICROLLM_URL=http://localhost:8090/v1
